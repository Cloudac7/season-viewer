{
  "name": "season-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "data:update": "node --import tsx scripts/update-snapshot.ts",
    "data:counties:update": "node --import tsx scripts/update-counties.ts",
    "data:counties:import": "node --import tsx scripts/import-counties.ts",
    "data:grid:import": "node --import tsx scripts/import-weather-grid.ts",
    "data:grid:update": "node --import tsx scripts/update-weather-grid.ts",
    "data:terrain:import": "node --import tsx scripts/import-terrain.ts",
    "data:precompute": "node --import tsx scripts/precompute-spatial.ts",
    "data:refresh": "node --import tsx scripts/refresh-precomputed.ts",
    "prebuild": "npm run data:precompute",
    "predev": "npm run data:precompute",
    "postbuild": "node --import tsx scripts/prune-publication.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.5.0",
    "d3-contour": "^4.0.2",
    "pngjs": "^7.0.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
