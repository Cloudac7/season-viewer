{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "season-atlas",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "season.tomori.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
