{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "season-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "season.tomori.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  }
}
